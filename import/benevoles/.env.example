# Copy to .env and adjust. Values here are read unless the variable is already
# set in the environment.

ADDR=:8080
BASE_URL=https://benevoles.example.org
DB_PATH=benevoles.db
UPLOAD_DIR=uploads
TIMEZONE=Europe/Paris
COOKIE_SECURE=1

# Staff (administrator) login through OpenID Connect. Register the application
# with the provider, redirect URL BASE_URL/admin/callback. ADMIN_EMAILS and/or
# ADMIN_GROUP (a value of the groups claim) say who is let in.
# Issuer example: https://auth.example.org/application/o/benevoles/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_EMAILS=
ADMIN_GROUP=

# Reverse proxies whose X-Forwarded-For header is believed: addresses or CIDR
# ranges, "private" for the loopback and private ranges (a proxy on the same
# host or Docker network), "none" when the server faces the Internet directly.
TRUSTED_PROXIES=private

# Profile pictures with no upload are fetched once from gravatar.com by the
# server and cached in UPLOAD_DIR; volunteers' browsers never contact it.
# Set to 0 to disable that lookup entirely.
GRAVATAR=1

# Daily reminder e-mail (local hour)
REMINDER_HOUR=18

# SMTP. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=benevoles@example.org

# Development only: print e-mails and login links to stdout instead of sending.
# DEV_MODE=1
