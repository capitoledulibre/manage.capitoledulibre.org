# Public URL, used in emails and logo URLs.
PARTNERS_BASE_URL=https://partners.example.org
PARTNERS_LISTEN=:8080
PARTNERS_DATA_DIR=./data

# Event identity, shown in pages and emails.
PARTNERS_SITE_NAME=Example Conf
PARTNERS_SITE_URL=https://conf.example.org
PARTNERS_CONTACT_EMAIL=partners@example.org
# Optional logo (SVG, PNG, JPEG or WebP) for the header and favicon.
# Without it, the header shows the initials of the name.
# PARTNERS_SITE_LOGO=/etc/partners/logo.svg

# Development mode: emails printed to logs, password-less admin login
# when OIDC is not configured. Never enable in production.
# PARTNERS_DEV=1

# SMTP. Without PARTNERS_SMTP_HOST emails are only logged.
PARTNERS_SMTP_HOST=smtp.example.org
PARTNERS_SMTP_PORT=587
PARTNERS_SMTP_TLS=starttls
PARTNERS_SMTP_USER=
PARTNERS_SMTP_PASSWORD=
# Defaults to "PARTNERS_SITE_NAME <PARTNERS_CONTACT_EMAIL>".
# PARTNERS_MAIL_FROM=Example Conf <partners@example.org>
# Comma-separated list notified when a partner changes something.
PARTNERS_STAFF_NOTIFY_EMAILS=partners@example.org

# Staff login (any OpenID Connect provider).
PARTNERS_OIDC_ISSUER=https://sso.example.org/realms/example
PARTNERS_OIDC_CLIENT_ID=partners
PARTNERS_OIDC_CLIENT_SECRET=
# Allowed staff: listed emails and/or members of a group (groups claim).
PARTNERS_ADMIN_EMAILS=
PARTNERS_ADMIN_GROUP=

# Token for GET /api/partners.json (Authorization: Bearer <token>), at least
# 32 characters: openssl rand -hex 32
PARTNERS_EXPORT_TOKEN=

PARTNERS_REMINDER_INTERVAL=6h
