# Copy to .env and adjust. Values here are read unless the variable is already
# set in the environment.

ADDR=:8080
BASE_URL=https://benevoles.example.org
DB_PATH=benevoles.db
UPLOAD_DIR=uploads
TIMEZONE=Europe/Paris
COOKIE_SECURE=1

# Daily reminder e-mail (local hour)
REMINDER_HOUR=18

# SMTP. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=benevoles@example.org

# Development only: print e-mails and login links to stdout instead of sending.
# DEV_MODE=1
