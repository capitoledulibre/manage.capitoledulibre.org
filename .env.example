# Public URL, used in emails and logo URLs.
MANAGE_BASE_URL=https://partners.example.org
MANAGE_LISTEN=:8080
MANAGE_DATA_DIR=./data

# Event identity, shown in pages and emails.
MANAGE_SITE_NAME=Example Conf
MANAGE_SITE_URL=https://conf.example.org
MANAGE_CONTACT_EMAIL=partners@example.org
# Optional logo (SVG, PNG, JPEG or WebP) for the header and favicon.
# Without it, the header shows the initials of the name.
# MANAGE_SITE_LOGO=/etc/partners/logo.svg

# Development mode: emails printed to logs, password-less admin login
# when OIDC is not configured. Never enable in production.
# MANAGE_DEV=1

# SMTP. Without MANAGE_SMTP_HOST emails are only logged.
MANAGE_SMTP_HOST=smtp.example.org
MANAGE_SMTP_PORT=587
MANAGE_SMTP_TLS=starttls
MANAGE_SMTP_USER=
MANAGE_SMTP_PASSWORD=
# Defaults to "MANAGE_SITE_NAME <MANAGE_CONTACT_EMAIL>".
# MANAGE_MAIL_FROM=Example Conf <partners@example.org>
# Comma-separated list notified when a partner changes something.
MANAGE_STAFF_NOTIFY_EMAILS=partners@example.org

# Staff login (any OpenID Connect provider).
MANAGE_OIDC_ISSUER=https://sso.example.org/realms/example
MANAGE_OIDC_CLIENT_ID=partners
MANAGE_OIDC_CLIENT_SECRET=
# Allowed staff: listed emails and/or members of a group (groups claim).
MANAGE_ADMIN_EMAILS=
MANAGE_ADMIN_GROUP=

# Token for GET /api/partners.json (Authorization: Bearer <token>), at least
# 32 characters: openssl rand -hex 32
MANAGE_EXPORT_TOKEN=

MANAGE_REMINDER_INTERVAL=6h
